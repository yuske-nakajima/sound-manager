{
  "name": "sound-manager",
  "version": "1.0.0",
  "description": "音源名を管理するためのCLIツール",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "fix": "biome check --write",
    "check": "tsc --noEmit && pnpm run lint",
    "prepare": "husky"
  },
  "keywords": [
    "sp404",
    "sound-manager",
    "cli"
  ],
  "author": "yuske-nakajima",
  "license": "UNLICENSED",
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "26.4.1",
    "husky": "9.1.7",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.5.1"
  },
  "dependencies": {
    "commander": "15.0.0",
    "yaml": "2.9.1"
  }
}
